{
  "name": "kami-paperbox",
  "private": true,
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/with-app-env.mjs next dev --hostname 0.0.0.0 --port 8080",
    "build": "node scripts/with-app-env.mjs next build && node scripts/migrate.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "preview": "node scripts/with-app-env.mjs next start --hostname 0.0.0.0 --port 8080",
    "start": "node scripts/with-app-env.mjs next start --hostname 0.0.0.0 --port 8080",
    "typecheck": "tsgo --noEmit",
    "test:e2e": "playwright test",
    "test": "node --test \"scripts/**/*.test.mjs\" && node --experimental-strip-types --test \"src/lib/**/*.test.ts\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "pack": "python3 scripts/pack.py",
    "kami": "node scripts/kami.mjs"
  },
  "dependencies": {
